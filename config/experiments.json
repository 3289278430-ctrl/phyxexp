          "as": "diam"
        },
        {
          "derive": {
            "as": "dn",
            "op": "mul",
            "a": "fit.k",
            "b": "data.m_load",
            "scale": 0.01
          }
        },
        {
          "derive": {
            "as": "u_dn",
            "op": "mul",
            "a": "fit.u_k",
            "b": "data.m_load",
            "scale": 0.01
          }
        },
