          "tool": "youngs_modulus",
          "params": {
            "m": "data.m_load",
            "g": "data.g",
            "L0": "data.L0",
            "D": "data.D",
            "b": "data.b",
            "d": "diam.d_mean",
            "dn": "dn",
            "u_m": "data.u_m",
            "u_g": "data.u_g",
            "u_L0": "data.u_L0",
            "u_D": "data.u_D",
            "u_b": "data.u_b",
            "u_d": "diam.u_d",
